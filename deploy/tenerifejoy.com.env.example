# Environment variables for tenerifejoy.com deployment
# Copy Strapi, Resend, and Telegram values from your existing service.

# --- Domain (required) ---
NEXT_PUBLIC_SITE_URL=https://tenerifejoy.com
NEXT_PUBLIC_SITE_NAME=Tenerife Joy

# --- CMS ---
NEXT_PUBLIC_STRAPI_API_URL=https://tenerifly-strapi-production.up.railway.app
NEXT_PUBLIC_STRAPI_API_TOKEN=

# --- Email / bookings ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_DEFAULT_EMAIL_RECIPIENT=
# RESEND_ENABLE_EXTRA_RECIPIENTS=true

# --- Telegram pre-book notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Node ---
NODE_ENV=production
