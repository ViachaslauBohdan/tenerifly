# Railway environment variables for master-legacy → plan-tenerife.com
# Copy values from your existing tenerifly.io Railway service, then set the site URL vars below.

# --- Domain (required for this deployment) ---
NEXT_PUBLIC_SITE_URL=https://plan-tenerife.com
NEXT_PUBLIC_SITE_NAME=plan-tenerife.com

# --- CMS (copy from tenerifly.io service) ---
NEXT_PUBLIC_STRAPI_API_URL=https://tenerifly-strapi-production.up.railway.app
NEXT_PUBLIC_STRAPI_API_TOKEN=

# --- Email / bookings (copy from tenerifly.io service) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_DEFAULT_EMAIL_RECIPIENT=
# RESEND_ENABLE_EXTRA_RECIPIENTS=true

# --- Telegram pre-book notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Node ---
NODE_ENV=production
