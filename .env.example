# Copy to .env.local and fill in values (never commit .env.local)

# Public site URL for this deployment (canonical links, sitemap, legal footer copy)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional display name (defaults to hostname from NEXT_PUBLIC_SITE_URL)
# NEXT_PUBLIC_SITE_NAME=your-domain.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender (use onboarding@resend.dev for local testing; use your verified domain in production)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inbox that receives booking form submissions
NEXT_DEFAULT_EMAIL_RECIPIENT=slawandr1@gmail.com

# Set to true only after verifying your domain on Resend (sends to property contactEmail too)
# RESEND_ENABLE_EXTRA_RECIPIENTS=true
