# Copy to .env.local and fill in values (never commit .env.local)

# Public site URL for this deployment (canonical links, sitemap, legal footer copy)
# Public site: https://tenerifejoy.com (see deploy/MASTER-LEGACY-DEPLOY.md)
# NEXT_PUBLIC_SITE_URL=https://tenerifejoy.com
# Optional display name (defaults to "Tenerife Joy")
# NEXT_PUBLIC_SITE_NAME=Tenerife Joy

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender (use onboarding@resend.dev for local testing; use your verified domain in production)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Inbox that receives booking form submissions
NEXT_DEFAULT_EMAIL_RECIPIENT=slawandr1@gmail.com

# Set to true only after verifying your domain on Resend (sends to property contactEmail too)
# RESEND_ENABLE_EXTRA_RECIPIENTS=true

# Stripe — https://dashboard.stripe.com/apikeys (see deploy/STRIPE-SETUP.md)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Strapi server writes (webhook — do not use NEXT_PUBLIC_ prefix)
STRAPI_API_URL=https://tenerifly-strapi-production.up.railway.app
STRAPI_API_TOKEN=
